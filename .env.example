# LLM operator-note interpretation (names only — never commit values).
# Copy to .env.local (gitignored) and fill in values there.
# Chain: OpenRouter -> Gemini (each optional, first configured wins).
# Legacy aliases still accepted: LLM_API_KEY (= OpenRouter key),
# LLM_MODEL (= OpenRouter model), LLM_FALLBACK_API_KEY (= Gemini key),
# LLM_FALLBACK_MODEL (= Gemini model).
OPENROUTER_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
GEMINI_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
